# Local development only. Copy this file to .env before starting Compose.
DB_NAME=crypto_graph
DB_USER=crypto_graph
DB_PASS=crypto_graph_local

JWT_SECRET=local-development-jwt-secret
JWT_EXPIRESIN=3600
JWT_REFRESH_SECRET=local-development-refresh-secret
JWT_REFRESH_EXPIRESIN=604800

# Google OAuth: create a Web OAuth client and add the callback URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4100/auth/google/callback
FRONTEND_URL=http://localhost:4000

# SMTP is required for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
